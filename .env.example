# Which Firebase project and bundle ID to build against: development | production
APP_ENV=development

# Phase 2 (Google Sign-In): Web client ID from the Firebase console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Phase 6 (RevenueCat): public SDK keys per platform
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# E2E / local dev: 1 = use the local Firebase Emulator Suite (npm run emulators) instead of the cloud
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=
